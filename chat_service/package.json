{
    "name": "chat_service",
    "version": "1.0.0",
    "description": "chat service of chat app",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "lint": "eslint . --ext .js,.cjs,.ts",
        "lint:fix": "eslint . --ext .js,.cjs,.ts --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "pretest": "npm run build",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "check": "npm run lint && npm run format:check && npm test"
    },
    "author": "Brandon Bautista",
    "license": "ISC",
    "devDependencies": {
        "@types/express": "^4.17.25",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.19.2",
        "@types/supertest": "^7.2.0",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^30.4.2",
        "prettier": "^3.9.4",
        "supertest": "^7.2.2",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "dotenv": "^16.6.1",
        "express": "^4.22.3",
        "mongoose": "^7.8.13"
    }
}
